<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="樱色 · 额度桌宠" Width="350" Height="350" WindowStyle="None"
        ResizeMode="NoResize" AllowsTransparency="True" Background="{x:Null}"
        ShowInTaskbar="False" ShowActivated="False" Topmost="False"
        FontFamily="Microsoft YaHei UI" UseLayoutRounding="True">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="#79659A"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="Button">
          <Border x:Name="ButtonBody" Background="{TemplateBinding Background}" CornerRadius="6" Padding="3,1">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBody" Property="Background" Value="#EDE7F6"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Viewbox x:Name="ScaleHost" Stretch="Uniform">
  <Canvas x:Name="AnimationStage" Width="378" Height="378">
  <Canvas x:Name="Root" Canvas.Left="14" Canvas.Top="14" Width="350" Height="350" RenderTransformOrigin="0.5,1">
    <Canvas.RenderTransform><TransformGroup><ScaleTransform x:Name="PressScale"/><ScaleTransform x:Name="FacingScale"/></TransformGroup></Canvas.RenderTransform>
    <Canvas x:Name="Bubble" Width="350" Height="239" Cursor="Hand" RenderTransformOrigin="0.4425,0.36">
      <Canvas.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Canvas.RenderTransform>
      <Path x:Name="BubbleShape" Fill="#FFF8FC" Stroke="#765A7B" StrokeThickness="4"
            StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
            Data="M 283,85 A 128,79 0 1 0 27,85 A 128,79 0 0 0 114,160 A 20,10 0 0 0 149,164 A 128,79 0 0 0 283,85 Z"/>
      <Grid x:Name="SceneText" Canvas.Left="63" Canvas.Top="22" Width="184" Height="115" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform><ScaleTransform x:Name="TextFacingScale"/></Grid.RenderTransform>
      <StackPanel x:Name="QuotaText" VerticalAlignment="Center">
        <Grid x:Name="HeaderRow" Height="16">
          <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="Header" Grid.Column="1" Text="剩余额度" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="136" TextAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontSize="12" LineHeight="16" LineStackingStrategy="BlockLineHeight" FontWeight="SemiBold" Foreground="#7D6B91" IsHitTestVisible="False" ToolTip="重置时间按当前机器的本地时间显示"/>
          <Button x:Name="Refresh" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Width="20" Height="16" Content="↻" FontSize="12" ToolTip="立即刷新额度"/>
        </Grid>
        <StackPanel x:Name="ShortRow" Margin="0,1,0,0" IsHitTestVisible="False">
        <Grid Height="25">
          <TextBlock x:Name="ShortLabel" Text="5 小时" FontSize="13" VerticalAlignment="Center" Foreground="#76638D"/>
          <TextBlock x:Name="ShortLeft" Text="—" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Segoe UI" FontSize="24" LineHeight="25" LineStackingStrategy="BlockLineHeight" FontWeight="Bold" Foreground="#765A7B"/>
        </Grid>
        <Border Height="4" Background="#EADDEB" CornerRadius="2" Margin="0,1,0,0">
          <Border x:Name="ShortBar" Background="#94B9E6" CornerRadius="2" Width="0" HorizontalAlignment="Left"/>
        </Border>
        <TextBlock x:Name="ShortReset" Text="等待额度数据" Margin="0,1,0,0" FontSize="12" LineHeight="15" LineStackingStrategy="BlockLineHeight" Foreground="#7D6B91"/>
        <TextBlock x:Name="ShortUsed" Visibility="Collapsed" Text="已用 —"/>
        </StackPanel>
        <StackPanel x:Name="WeekRow" Margin="0,4,0,0" IsHitTestVisible="False">
        <Grid Height="25">
          <TextBlock x:Name="WeekLabel" Text="每周" FontSize="13" VerticalAlignment="Center" Foreground="#76638D"/>
          <TextBlock x:Name="WeekLeft" Text="—" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Segoe UI" FontSize="24" LineHeight="25" LineStackingStrategy="BlockLineHeight" FontWeight="Bold" Foreground="#765A7B"/>
        </Grid>
        <Border Height="4" Background="#EADDEB" CornerRadius="2" Margin="0,1,0,0">
          <Border x:Name="WeekBar" Background="#94B9E6" CornerRadius="2" Width="0" HorizontalAlignment="Left"/>
        </Border>
        <TextBlock x:Name="WeekReset" Text="等待额度数据" Margin="0,1,0,0" FontSize="12" LineHeight="15" LineStackingStrategy="BlockLineHeight" Foreground="#7D6B91"/>
        <TextBlock x:Name="WeekUsed" Visibility="Collapsed" Text="已用 —"/>
        </StackPanel>
        <TextBlock x:Name="Status" Visibility="Collapsed" Text="正在读取额度…"/>
      </StackPanel>
        <TextBlock x:Name="QuoteText" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" FontSize="20" FontWeight="Bold" LineHeight="25" Foreground="#765A7B" IsHitTestVisible="False" Text="我在这儿，慢慢来就好。"/>
      </Grid>
    <Ellipse x:Name="LiveDot" Visibility="Collapsed" Canvas.Left="134" Canvas.Top="17" Width="4" Height="4" Fill="#86ABD8" IsHitTestVisible="False"/>
    </Canvas>
    <Ellipse x:Name="Tail" Canvas.Left="108" Canvas.Top="182" Width="25" Height="18" Fill="#FFF8FC" Stroke="#765A7B" StrokeThickness="4" RenderTransformOrigin="0.5,0.5">
      <Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform>
    </Ellipse>
    <Ellipse x:Name="TailNear" Canvas.Left="142" Canvas.Top="214" Width="17" Height="12" Fill="#FFF8FC" Stroke="#765A7B" StrokeThickness="4" RenderTransformOrigin="0.5,0.5">
      <Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform>
    </Ellipse>
    <Image x:Name="Girl" Canvas.Left="142" Canvas.Top="142" Width="208" Height="208" Stretch="Uniform" Cursor="Hand" RenderTransformOrigin="0.5,0.5"
           ToolTip="点角色看台词；点头顶圆环看额度；拖动调整位置；右键设置"><Image.RenderTransform><ScaleTransform ScaleX="-1"/></Image.RenderTransform></Image>
    <Grid x:Name="QuotaCapsule" Canvas.Left="200" Canvas.Top="110" Width="92" Height="40" RenderTransformOrigin="0.5,0.5">
      <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="12"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
      <Button x:Name="ShortQuotaButton" Grid.Column="0" Width="40" Height="40" Cursor="Hand" Foreground="#F6EFFC" AutomationProperties.Name="5小时剩余额度" ToolTip="5小时剩余额度 · 点击查看额度">
        <Button.Template><ControlTemplate TargetType="Button"><Grid><Ellipse x:Name="CircleBody" Fill="#473B56"/><ContentPresenter/></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CircleBody" Property="Fill" Value="#5B4869"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
        <Grid Width="40" Height="40"><Ellipse Stroke="#73657F" StrokeThickness="4" Margin="4"/><Ellipse x:Name="CapsuleRing" Stroke="#D8B3E2" StrokeThickness="4" Margin="4" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><RotateTransform Angle="-90"/></Ellipse.RenderTransform></Ellipse><TextBlock x:Name="CapsuleValue" Text="—" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" FontWeight="SemiBold"/></Grid>
      </Button>
      <Button x:Name="WeekQuotaButton" Grid.Column="2" Width="40" Height="40" Cursor="Hand" Foreground="#F6EFFC" AutomationProperties.Name="每周剩余额度" ToolTip="每周剩余额度 · 点击查看额度">
        <Button.Template><ControlTemplate TargetType="Button"><Grid><Ellipse x:Name="CircleBody" Fill="#473B56"/><ContentPresenter/></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CircleBody" Property="Fill" Value="#5B4869"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
        <Grid Width="40" Height="40"><Ellipse Stroke="#73657F" StrokeThickness="4" Margin="4"/><Ellipse x:Name="CapsuleWeekRing" Stroke="#F2B4CF" StrokeThickness="4" Margin="4" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><RotateTransform Angle="-90"/></Ellipse.RenderTransform></Ellipse><TextBlock x:Name="CapsuleWeekValue" Text="—" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" FontWeight="SemiBold"/></Grid>
      </Button>
    </Grid>
    <Border x:Name="QuotaNotice" Canvas.Left="16" Canvas.Top="14" Width="292" Height="76" Background="#FFF4FA" BorderBrush="#DDBCD9" BorderThickness="1" CornerRadius="14" Padding="12,8" Visibility="Collapsed" Cursor="Hand" RenderTransformOrigin="0.5,0.5"><TextBlock x:Name="QuotaNoticeText" TextWrapping="Wrap" FontSize="12" LineHeight="17" Foreground="#765473" TextTrimming="CharacterEllipsis"/></Border>
    <Button x:Name="MenuButton" Canvas.Left="320" Canvas.Top="162" Width="24" Height="24" Content="☰"
            FontSize="15" Opacity="0" IsHitTestVisible="False" Background="#EDE7F6" ToolTip="挂件设置"/>
  </Canvas>
  </Canvas>
  </Viewbox>
</Window>
