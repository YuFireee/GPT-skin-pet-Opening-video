<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="350" Height="596" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" FontFamily="Microsoft YaHei UI" Foreground="#51445F">
 <Window.Resources><Style TargetType="Button"><Setter Property="Background" Value="#EBE2F2"/><Setter Property="Foreground" Value="#695377"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,8"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#DECFEA"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></Window.Resources>
 <Border Background="#FCF9FF" BorderBrush="#E1D6E9" BorderThickness="1" CornerRadius="20" Padding="20">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
  <Grid Margin="0,0,0,12"><TextBlock Text="樱色 · 额度" FontSize="19" FontWeight="SemiBold"/><Button x:Name="CardSettings" Content="⚙" Width="30" Height="28" Padding="0" HorizontalAlignment="Right" Margin="0,0,36,0" ToolTip="设置与诊断"/><Button x:Name="CollapseCard" Content="−" Width="30" Height="28" Padding="0" HorizontalAlignment="Right" ToolTip="收回胶囊"/></Grid>
  <TextBlock x:Name="QuotaPlan" Text="订阅额度" Foreground="#A08CAD" Margin="0,0,0,10"/>
  <Border Background="#F2ECF7" CornerRadius="13" Padding="14" Margin="0,0,0,9"><StackPanel><Grid><TextBlock x:Name="CardShortLabel" Text="5 小时剩余" Foreground="#887294"/><TextBlock x:Name="CardShortValue" Text="—" FontSize="25" FontWeight="SemiBold" HorizontalAlignment="Right"/></Grid><TextBlock x:Name="CardShortReset" Text="等待读取" Foreground="#9986A3" FontSize="11" Margin="0,6,0,0"/></StackPanel></Border>
  <Border Background="#F2ECF7" CornerRadius="13" Padding="14" Margin="0,0,0,12"><StackPanel><Grid><TextBlock x:Name="CardWeekLabel" Text="每周剩余" Foreground="#887294"/><TextBlock x:Name="CardWeekValue" Text="—" FontSize="25" FontWeight="SemiBold" HorizontalAlignment="Right"/></Grid><TextBlock x:Name="CardWeekReset" Text="等待读取" Foreground="#9986A3" FontSize="11" Margin="0,6,0,0"/></StackPanel></Border>
  <TextBlock Text="Token · 本机记录" Foreground="#887294" FontSize="12"/>
  <Grid Margin="0,8,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="近7天" FontSize="11" Foreground="#A08CAD"/><TextBlock x:Name="CardSevenTokens" Text="—" FontSize="21"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="约5小时" FontSize="11" Foreground="#A08CAD"/><TextBlock x:Name="CardFiveTokens" Text="—" FontSize="21"/></StackPanel></Grid>
  <TextBlock x:Name="CardFreshness" Text="未读取" FontSize="10" Foreground="#A08CAD" TextWrapping="Wrap" Height="32" Margin="0,4,0,10"/>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="RefreshCard" Content="刷新额度"/><Button x:Name="OpenReport" Grid.Column="2" Content="查看日报"/></Grid>
  <Border Background="#F2ECF7" CornerRadius="12" Padding="10" Margin="0,12,0,4"><StackPanel>
   <TextBlock Text="额外重置公告 · 第三方" FontSize="12" FontWeight="SemiBold"/>
   <TextBlock x:Name="CardAnnouncement" Text="等待获取公告" TextWrapping="Wrap" FontSize="11" Margin="0,5,0,4" MaxHeight="48"/>
   <Button x:Name="AnnouncementLink" Content="来源：Codex Resets ↗" FontSize="10" Padding="4,3" HorizontalAlignment="Left"/>
  </StackPanel></Border>
  <WrapPanel x:Name="CardShortcuts" Margin="0,4,0,0"/>
 </StackPanel></ScrollViewer></Border>
</Window>