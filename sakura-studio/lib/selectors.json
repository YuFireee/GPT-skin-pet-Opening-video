  "native-backdrops": "[class*=\"_MainContentTopFade_\"], [class~=\"group/thread-scroll-layout\"] [class~=\"pointer-events-none\"][class~=\"bg-gradient-to-t\"][class~=\"from-surface\"], [class~=\"group/thread-scroll-layout\"] [class~=\"pointer-events-none\"][class~=\"bg-surface\"][class~=\"mt-8\"], [class~=\"group/thread-scroll-layout\"] [class*=\"_background_\"][class~=\"pointer-events-none\"][class~=\"absolute\"][class~=\"inset-x-0\"]"
}
