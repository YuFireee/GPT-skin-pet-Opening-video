{
  "shell-main": "main:is(.main-surface, [data-app-shell-main-surface], [class*=\"_MainContentSurface_\"])",
  "left-panel": "aside.app-shell-left-panel",
  "header-tint": "header:is(.app-header-tint, [data-app-shell-header-edge-scroll], [class*=\"_Header_\"])",
  "home-route": "[role=\"main\"]:has([data-testid=\"home-icon\"])",
